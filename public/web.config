<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- ให้ทุกเส้นทาง (เช่น /day/2026-10-05) ตกมาที่ index.html -->
    <rewrite>
      <rules>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>


    <!-- header ความปลอดภัยพื้นฐาน (เปิดใช้เลย ไม่กระทบการทำงานของแอป) -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <!-- Content-Security-Policy: ทดสอบแล้วในเบราว์เซอร์ Chromium (e2e/csp.e2e.js) ว่าแอปทำงานครบ
             ยังปิดไว้ก่อน เพราะยังไม่ได้ลองบน Safari/Firefox จริง ถ้าจะเปิด: ลบเครื่องหมายคอมเมนต์ แล้วลองใช้งานทุกหน้าบนมือถือก่อนใช้จริง
             หมายเหตุ: ถ้าแก้สคริปต์ใน index.html ค่า sha256 ต้องเปลี่ยนตาม (เทสต์ web-config.test.js จะเตือน)
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'sha256-pqrzC9P4jBh456qt+gWOsxPZHsH5VOEjckeQhjDutZo='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" />
        -->
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- ไฟล์ที่มี hash ในชื่อ แคชยาวได้ -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

  </system.webServer>

  <!-- ไฟล์เหล่านี้ห้ามติดแคช ไม่งั้นอัปเดตเวอร์ชันไม่ขึ้น -->
  <location path="sw.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="manifest.webmanifest">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
