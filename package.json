{
  "name": "todaytask",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:root": "vite build --mode root --outDir dist-root --emptyOutDir",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:tz": "node scripts/test-tz.mjs",
    "test:e2e": "npm run build && npm run build:root && vitest run --config vitest.e2e.config.js",
    "verify": "node scripts/verify-deploy.mjs",
    "check": "npm run lint && npm run build && npm run build:root && npm test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.56.1",
    "prettier": "^3.9.9",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
